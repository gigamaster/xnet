---
import { SITE } from '~/config.mjs';
import { getCanonical, getHomePermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import AutonomyLocalFirst from '~/components/widgets/AutonomyLocalFirst.astro';
import Apps from '~/components/widgets/Apps.astro';
import Steps from '~/components/widgets/Steps.astro';
import CorePrinciples from '~/components/widgets/CorePrinciples.astro';
import HighlightedPosts from '~/components/blog/HighlightedPosts.astro';

const meta = {
	title: SITE.title,
	description: SITE.description,
	canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
	<Hero />
	<AutonomyLocalFirst />
	<CorePrinciples />
	<Steps />
	<Apps />
	<HighlightedPosts />
</Layout>
