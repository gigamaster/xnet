---
import IconLocal from '~/components/atoms/IconLocal.astro';

const items = [
	{
		title: 'OS for Homelab',
		description:
			'Operating systems and platforms that run on your own hardware. Turnkey or fully open, your choice, your control.',
		icon: 'icon-terminal',
		link: 'self-hosted/',
	},
	{
		title: 'Self-Hosted Apps',
		description:
			'Productivity, media, and file sharing, private by design. Local-first autonomy, with no tracking or hidden costs.',
		icon: 'fluent-color--apps-24',
		link: 'applications/',
	},
	{
		title: 'Portable Apps',
		description:
			'Click-and-run tools and system utilities. Download open-source binaries that require no installation and leave no trace.',
		icon: 'flat-color-usb',
		link: 'portable/',
	},
	{
		title: 'HomeLab Hardware',
		description:
			'Your hardware, your rules. Run dev servers, stream media, host databases, locally, permanently, privately.',
		icon: 'fluent-color--laptop-24',
		link: 'hardware/',
	},
	{
		title: 'Stack Components',
		description:
			'Essential software layers to assemble your homelab: local development, media servers, private AI, secure access, and utilities.',
		icon: 'fluent-color--toolbox-24',
		link: 'stack-components/',
	},
	{
		title: 'Knowledge Base',
		description:
			'Honest software reviews and beginner-friendly guides. Step-by-step tutorials to help you build your independence.',
		icon: 'fluent-color--book-open-lightbulb-24',
		link: 'blog/',
	},
];
---

<section class="relative scroll-mt-16" id="ecosystem">
	<div class="absolute inset-0 bg-primary-50 dark:bg-zinc-950 pointer-events-none mb-32" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
		<div class="py-4 pt-8 sm:py-6 lg:py-8 lg:pt-12">
			<div class="mb-8 text-center">
				<p class="text-base text-primary-600 dark:text-primary-500 font-semibold tracking-wide uppercase">Codemo Digital Nomad</p>
				<h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 pb-4 font-heading bg-clip-text text-transparent bg-radial-[at_50%_65%] from-sky-200 via-blue-400 to-indigo-900 to-90%">
					Autonomy in Motion
				</h2>
				<p class="max-w-3xl mx-auto text-center text-xl text-zinc-600 dark:text-zinc-400">
					Break free from constant connectivity and restrictive subscriptions. 
					Run local-first, and portable versions of the world's best open-source software.
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start my-16">
				{
					items.map(({ title, description, icon, link }) => (
						<a href={link} class="group">
							<div class="relative flex flex-col p-6 bg-zinc-500/20 backdrop-blur-xs rounded-lg shadow-lg border border-zinc-700 group-hover:shadow-2xl transition-all duration-300">
								<div class="flex items-center mb-4">
									<IconLocal name={icon} class="w-10 h-10 group-hover:scale-110 transition-transform duration-300" />
									<div class="ml-4 text-xl font-bold group-hover:text-lime-500 transition-colors duration-300">{title}</div>
								</div>
								<p class="text-zinc-500 dark:text-zinc-400 text-md group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors duration-300">{description}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>
