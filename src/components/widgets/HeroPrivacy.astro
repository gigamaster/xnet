---
import IconLocal from '~/components/atoms/IconLocal.astro';
import { Image } from 'astro:assets';

const { meta = {} } = Astro.props;

const items = [

	{
		title: 'Element',
		description:
			'Decentralized, encrypted chat. The open standard for secure, sovereign communication.',
		icon: 'brand-docker',
	},
	{
		title: 'Nextcloud',
		description:
			'The sovereign alternative to Google Workspace. Managed files, photos, and calendars.',
		icon: 'brand-kinsta',
	},
	{
		title: 'Proton',
		description:
			'Modern, secure email hosting. Reclaim your inbox from corporate data-mining and trackers.',
		icon: 'brand-local-wp',
	},
	{
		title: 'Etherpad',
		description:
			'Real-time collaborative documents. Zero-knowledge editing for teams and solo nomads.',
		icon: 'brand-mamp',
	},
	{
		title: 'Stirling-PDF',
		description:
			'A powerful, local-first PDF toolkit. View, edit, merge, and sign without data leaving your server.',
		icon: 'brand-xampp',
	},
	{
		title: 'Vaultwarden',
		description:
			'A lightweight Bitwarden-compatible server. Secure your passwords with end-to-end encryption.',
		icon: 'battery',
	},
];
---

<section class="relative">
	<div class="absolute inset-0 bg-radial-[at_50%_25%] from-sky-900 via-indigo-950 to-zinc-900 to-90% pointer-events-none mb-16" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4">
		<div class="text-zinc-300 py-4 pt-8">
			<div class="mb-8 text-center">
				<p class="text-base font-semibold tracking-wide uppercase">Stack</p>
				{meta.title && 
				<h2 class="text-zinc-100 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					{meta.title}
				</h2>
				}
				{meta.description && 
				<p class="max-w-3xl mx-auto text-center text-xl">
					{meta.description}
				</p>
				}
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start my-8">
				{
					items.map(({ title, description, icon }) => (
						<div class="relative flex flex-col p-6 bg-zinc-500/20 backdrop-blur-xs rounded-lg shadow-lg border border-zinc-700">
							<div class="flex items-center mb-4">
								<IconLocal name={icon} class="w-12 h-12" />

								<div class="ml-4 text-xl font-bold">{title}</div>
							</div>
							<p class="text-md">{description}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
