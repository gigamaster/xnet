---
import IconLocal from '~/components/atoms/IconLocal.astro';
---

<section class="bg-linear-to-b from-black to-zinc-900">
	<div class="max-w-6xl h-[calc(100vh-100px)] mx-auto px-4 sm:px-6 bg-[url(~/assets/images/xnet-digital-homelab.jpg)] bg-bottom bg-center bg-no-repeat bg-fixed">
		<div class="pt-4 pb-28l">
			<div class="text-center pb-24 md:pb-16">
				<h1 class="text-5xl md:text-[3.50rem] font-bold leading-tighter tracking-tighter mb-4 font-heading">
					<span class="bg-clip-text text-transparent bg-linear-to-r from-amber-500 to-zinc-200">Digital</span>
					<span
						class="bg-clip-text text-transparent bg-linear-to-r from-zinc-200 to-amber-600 sm:whitespace-nowrap"
						> Sovereignty</span
					>
				</h1>
				<div class="max-w-3xl mx-auto">
					<p class="text-xl text-zinc-600 mb-24 dark:text-zinc-300">
						Break free from cloud lock-in. Run portable & web apps, host your own secure server, 
						and leverage offline AI with 100% open-source tools designed for the mobile professional.
					</p>
					<div class="max-w-none px-6 py-16 flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
						<div class="flex w-full sm:w-auto">
							<a
								class="btn text-white border border-zinc-500 bg-zinc-800/80 hover:bg-sky-800/70 hover:border-sky-200 shadow-xl sm:mb-0 w-full py-4"
								href="#ecosystem"
							>
								Explore the Ecosystem
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
