---
import IconLocal from '~/components/atoms/IconLocal.astro';

const items = [
	{
		title: 'Components',
		description:
			'Essential building blocks for your homelab, including dashboards, reverse proxies, and monitoring tools to organize and manage your self-hosted services.',
		icon: 'battery',
	},
	{
		title: 'Local Server',
		description:
			'Core applications for file sharing, productivity, and collaboration, like cloud storage and note-taking, running privately on your own hardware.',
		icon: 'battery',
	},
	{
		title: 'Local AI',
		description:
			'Powerful open-source tools to run AI models locally, including LLMs, image generation, and chat interfaces, for privacy-focused inference without cloud dependency.',
		icon: 'battery',
	},
	{
		title: 'Secure Tunneling',
		description:
			'Solutions for safe remote access to your homelab, such as VPNs and tunnels, enabling secure exposure of services without opening ports.',
		icon: 'battery',
	},
	{
		title: 'Multimedia',
		description:
			'Self-hosted media servers and libraries for streaming movies, music, photos, and books, turning your setup into a personal entertainment hub.',
		icon: 'battery',
	},
	{
		title: 'Privacy & Security',
		description:
			'Tools to enhance protection, including ad blockers, password managers, authentication systems, and network monitors, keeping your data and traffic secure.',
		icon: 'battery',
	},
];
---

<section class="relative">
	<div class="absolute inset-0 bg-radial-[at_50%_25%] from-sky-900 via-indigo-950 to-zinc-900 to-90% pointer-events-none mb-32" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
		<div class="py-4 pt-8 sm:py-6 lg:py-8 lg:pt-12">
			<div class="mb-8 text-center">
				<p class="text-base text-primary-600 dark:text-primary-200 font-semibold tracking-wide uppercase">Stack</p>
				<h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					Essential Self-Hosting Tools
				</h2>
				<p class="max-w-3xl mx-auto text-center text-xl text-zinc-600 dark:text-zinc-400">
					Unlocking the true power of self-hosting: professional, accessible, and truly yours.
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start my-12 dark:text-white">
				{
					items.map(({ title, description, icon }) => (
						<div class="relative flex flex-col p-6 bg-white dark:bg-zinc-900 rounded shadow-xl hover:shadow-lg transition dark:border dark:border-zinc-800">
							<div class="flex items-center mb-4">
								<IconLocal name={icon} class="w-12 h-12" />

								<div class="ml-4 text-xl font-bold">{title}</div>
							</div>
							<p class="text-zinc-500 dark:text-zinc-400 text-md">{description}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
