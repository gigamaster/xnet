---
import IconLocal from '~/components/atoms/IconLocal.astro';

const items = [
	{
		title: 'CasaOS',
		description:
			'Docker-focused dashboard on top of Linux (often Ubuntu/Debian). Super simple app store; perfect for quick self-hosting without deep config.',
		icon: 'os-casaos',
		link: '/self-hosted#casaos',
	},
	{
		title: 'Cosmos Cloud',
		description:
			'Secure gateway and app manager (Docker-based, install via script). User-friendly UI with a strong emphasis on security (auth, anti-DDOS); one-click apps.',
		icon: 'os-cosmoscloud',
		link: '/self-hosted#cosmos-cloud',
	},
	{
		title: 'Proxmox VE',
		description:
			'Debian-based hypervisor, great for VMs and containers. Excellent for mini PCs, clustering, backups, and running multiple services. Best for advanced users.',
		icon: 'os-proxmox',
		link: '/self-hosted#proxmox-ve',
	},
	{
		title: 'RunTipi',
		description:
			'Docker-focused personal homeserver orchestrator with a simple, beautiful web interface and one-click app store. Lightweight, beginner-friendly.',
		icon: 'os-runtipi',
		link: '/self-hosted#runtipi',
	},
	{
		title: 'startos',
		description:
			'General-purpose Linux. Rock-solid base for manual Docker setups; huge community. Best for: Custom setups or as a base under other tools.',
		icon: 'os-ubuntu',
		link: '/self-hosted#startos',
	},
	{
		title: 'TrueNAS SCALE',
		description:
			'Linux/BSD-based NAS OS with ZFS storage. Best-in-class for storage-focused homelabs, with built-in apps and containers. Best for media servers, backups, and file sharing.',
		icon: 'os-truenas',
		link: '/self-hosted#truenas',
	},
	{
		title: 'UmbrelOS',
		description:
			'Full OS (installable on mini PCs, Raspberry Pi, or VMs). Elegant UI, app store (Nextcloud, Jellyfin, Bitcoin node, etc.). Now general self-hosting.',
		icon: 'os-umbrelos',
		link: '/self-hosted#umbrelos',
	},
	{
		title: 'YunoHost',
		description:
			'Full self-hosting platform/OS with a clean dashboard and massive app catalog, with built-in apps and containers. Privacy-focused, and easy for non-experts.',
		icon: 'os-yunohost',
		link: '/self-hosted#yunohost',
	},
	{
		title: 'ZimaOS',
		description:
			'Standalone Docker/NAS OS (from IceWhale, makers of ZimaBoard/Cube). Lightweight, focused on apps like Jellyfin/Plex/Immich; low power draw on mini PCs.',
		icon: 'os-zimaos',
		link: '',
	},
];
---

<section class="relative" id="homelab">
	<div class="absolute inset-0 bg-radial-[at_50%_25%] from-amber-900 via-orange-950 to-zinc-900 to-90% pointer-events-none mb-32" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
		<div class="py-4 pt-8 sm:py-6 lg:py-8 lg:pt-12">
			<div class="mb-8 text-center">
				<p class="text-base text-zinc-200 font-semibold tracking-wide uppercase mb-2">Operating Systems</p>
				<h2 class="text-4xl text-white md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					Popular OS for Homelab
				</h2>
				<p class="max-w-3xl mx-auto text-center text-xl text-zinc-300">
					Optimized for mini PCs and compact hardware
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start my-12 text-white">
				{
					items.map(({ title, description, icon, link }) => (
						<a href={link} class="group">

						<div class="relative flex flex-col p-6 bg-zinc-500/20 backdrop-blur-xs rounded-lg shadow-lg border border-amber-700/50">
							<div class="flex items-center mb-4 text-white">
								<IconLocal name={icon} class="w-8 h-8 group-hover:scale-110 transition-transform duration-300" />

								<div class="ml-4 text-2xl font-bold group-hover:text-lime-500 transition-colors duration-300">{title}</div>
							</div>
							<p class="text-zinc-300 text-md">{description}</p>
						</div>
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>
