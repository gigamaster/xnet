---
import IconLocal from '~/components/atoms/IconLocal.astro';
import Picture from '~/components/core/Picture.astro';
---

<section class="max-w-6xl mx-auto mb-16" id="self-host">
	<div class="grid gap-4 md:grid-cols-2">
		<div class="mx-auto p-4">
			<h2 class="mb-8 text-3xl lg:text-4xl font-bold font-heading">
				Build Your Homelab
			</h2>
			<p class="italic mb-8">
			Whether you want a one-click appliance or a fully open stack, your homelab starts with three choices:
			</p>
			<div class="flex">
				<div class="flex flex-col items-center mr-4">
					<div>
						<div class="flex items-center justify-center w-10 h-10 rounded-full border-sky-500 border-2">
							<IconLocal name="fluent--arrow-down-24-regular" class="w-6 h-6 text-zinc-600 dark:text-zinc-200 icon-bold" />
						</div>
					</div>
					<div class="w-px h-full bg-zinc-300 dark:bg-zinc-500"></div>
				</div>
				<div class="pt-1 pb-8">
					<p class="mb-2 text-xl font-bold text-zinc-900 dark:text-zinc-300">Step 1: Homelab Hardware</p>
					<p class="italic">Choose your machine</p>
					<p>
						Old PC or Mac, modern mini-PC, NAS, or Raspberry Pi.<br />
						<a href="hardware/" class="text-sky-500 hover:text-lime-500">→ Explore hardware</a>
					</p>
				</div>
			</div>
			<div class="flex">
				<div class="flex flex-col items-center mr-4">
					<div>
						<div class="flex items-center justify-center w-10 h-10 rounded-full border-sky-600 border-2">
							<IconLocal name="fluent--arrow-down-24-regular" class="w-6 h-6 text-zinc-600 dark:text-zinc-200 icon-bold" />
						</div>
					</div>
					<div class="w-px h-full bg-zinc-300 dark:bg-zinc-500"></div>
				</div>
				<div class="pt-1 pb-8">
					<p class="mb-2 text-xl font-bold text-zinc-900 dark:text-zinc-300">Step 2: Operating System</p>
					<p class="italic">OS for Homelab</p>
					<p>
						Install a transparent open OS. No black boxes.<br />
						<a href="self-hosted/" class="text-sky-500 hover:text-lime-500">→ Compare OS options</a>
					</p>
				</div>
			</div>
			<div class="flex">
				<div class="flex flex-col items-center mr-4">
					<div>
						<div class="flex items-center justify-center w-10 h-10 rounded-full border-sky-700 border-2">
							<IconLocal name="fluent--arrow-down-24-regular" class="w-6 h-6 text-zinc-600 dark:text-zinc-200 icon-bold" />
						</div>
					</div>
					<div class="w-px h-full bg-zinc-300 dark:bg-zinc-500"></div>
				</div>
				<div class="pt-1 pb-8">
					<p class="mb-2 text-xl font-bold text-zinc-900 dark:text-zinc-300">Step 3: Stack Components</p>
					<p class="italic">Self-Host Apps.</p>
					<p> 
						Assemble your toolkit and secure access.<br />
						<a href="stack-components/" class="text-sky-500 hover:text-lime-500">→ Browse stack</a>
					</p>
				</div>
			</div>
			<div class="flex">
				<div class="flex flex-col items-center mr-4">
					<div>
						<div class="flex items-center justify-center w-10 h-10 rounded-full border-lime-600 border-2">
							<IconLocal name="fluent--arrow-down-24-regular" class="w-6 h-6 text-zinc-600 dark:text-zinc-200 icon-bold" />
						</div>
					</div>
				</div>
				<div class="pt-1">
					<p class="mb-2 text-xl font-bold text-zinc-900 dark:text-zinc-300">Ready!</p>
					<p class="text-zinc-900 dark:text-zinc-300">
					Your homelab, your data, your rules!<br />
					No rent, no tracking, no hidden locks.
					</p>
				</div>
			</div>
		</div>
		<div class="relative">
			<Picture
				class="inset-0 w-full rounded-xl shadow-lg md:absolute md:h-full bg-zinc-400 dark:bg-zinc-700"
				src={import('~/assets/images/homelab-hardware.jpg')}
				sizes="(max-width: 720px) 100vw, 720px"
				alt="Homelab Hardware"
			/>
		</div>
	</div>
</section>
