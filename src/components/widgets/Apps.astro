---
import IconLocal from '~/components/atoms/IconLocal.astro';

const items = [
	[
		{
			title: 'Communication',
			description:
				'P2P messaging and protocols for decentralized, serverless team sync.',
			icon: 'fluent-color--chat-multiple-24',
			link: '/applications#communication-private',
		},
		{
			title: 'Productivity & Office',
			description:
				'Local-first editors using Markdown and OpenDocument file formats.',
			icon: 'fluent-color--document-folder-24',
			link: '/applications#productivity-office',
		},
		{
			title: 'Finance & Capital',
			description:
				'Self-custody assets and private multi-currency wealth management.',
			icon: 'fluent-color--coin-multiple-24',
			link: '/applications#finance',
		},
		{
			title: 'Creative Suite',
			description:
				'Photo, video, and vector design tools without subscriptions.',
			icon: 'fluent-color--design-ideas-24',
			link: '/applications#creative-software',
		},

	],
	[
		{
			title: 'Local AI & LLMs',
			description:
				'Run language models and image generators on your hardware. No API fees, no data tracking.',
			icon: 'fluent-color--bot-sparkle-24',
			link: '/applications#local-ai-llm',
		},
		{
			title: 'Network & Hosting',
			description:
				'Personal servers and cloud-in-a-box for total infrastructure control without a middleman.',
			icon: 'fluent-color--globe-shield-24',
			link: '/applications#network-hosting',
		},
		{
			title: 'Privacy & Security',
			description:
				'Hardened browsers, encrypted vaults, and secure VPN tunnels.',
			icon: 'fluent-color--shield-24',
			link: '/stack-privacy',
		},
		{
			title: 'Knowledge Database',
			description:
				'Permanent, queryable archives and linked-note second brains.',
			icon: 'fluent-color--book-database-24',
			link: '/applications#knowledge',
		},
	],
];
---

<section class="scroll-mt-16" id="apps">
	<div class="px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20 bg-zinc-100 dark:bg-zinc-950/80 rounded-xl">
		<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
			<p class="text-base text-primary-600 dark:text-primary-200 font-semibold tracking-wide uppercase">Applications</p>
			<h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
				Web Apps for <span
					class="bg-clip-text text-transparent bg-gradient-to-r from-zinc-200 via-amber-500 to-indigo-700"
					>Digital Nomads</span
				>
			</h2>
			<p class="max-w-3xl mx-auto sm:text-center text-xl text-zinc-600 dark:text-zinc-400">
				Explore open-source alternatives. Every tool listed is selected for its portability, low resource footprint, and commitment to user autonomy.
			</p>
		</div>
		<div class="grid mx-auto space-y-6 md:grid-cols-2 md:space-y-4">
			{
				items.map((subitems) => (
					<div class="space-y-6 sm:px-6">
						{subitems.map(({ title, description, icon, link }) => (
							<a href={link} class="group">
							<div class="flex flex-row mb-4 max-w-md group-hover:border-zinc-700 group-hover:shadow-xl transition-all duration-300">
								<div class="mb-4 mr-4">
									<div class="flex items-center justify-center w-12 h-12 rounded-full bg-primary-900">
										<IconLocal name={icon} class="w-10 h-10 p-0.5" />
									</div>
								</div>
								<div>
									<h5 class="mb-3 text-xl font-bold group-hover:text-lime-500 transition-colors duration-300">{title}</h5>
									<p class="text-zinc-500 dark:text-zinc-400 text-md group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors duration-300">{description}</p>
								</div>
							</div>
							</a>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
