---
import IconLocal from '~/components/atoms/IconLocal.astro';
import { Image } from 'astro:assets';

const { meta = {} } = Astro.props;

const items = [
	{
		title: 'Local Server',
		description:
			'Run Apache, MySQL, and PHP or Python locally via simple GUI tools.',
		icon: 'fluent-color--database-24',
	},
	{
		title: 'Local AI',
		description:
			'Run LLMs on your machine, private, offline, no fees, full control.',
		icon: 'fluent-color--bot-sparkle-24',
	},
	{
		title: 'Secure Tunneling',
		description:
			'Access from anywhere, no public IP, no open ports, zero trust required.',
		icon: 'fluent-color--globe-shield-24',
	},
	{
		title: 'Self-Hosted PaaS',
		description:
			'Deploy and manage apps with open-source PaaS tools like Coolify or CapRover.',
		icon: 'fluent-color--wrench-screwdriver-24',
	},
	{
		title: 'Multimedia',
		description:
			'Stream and organize personal media with full privacy, control, and no ads.',
		icon: 'fluent-color--video-24',
	},
	{
		title: 'Privacy & Security',
		description:
			'self-hosted apps to eliminate corporate tracking, and secure personal data.',
		icon: 'fluent-color--mail-24',
	},
];
---

<section class="relative">
	<div class="absolute inset-0 bg-radial-[at_50%_25%] from-zinc-800 via-neutral-850 to-zinc-900 to-90% pointer-events-none mb-16" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4">
		<div class="text-zinc-300 py-4 pt-8">
			<div class="mb-8 text-center">
				<p class="text-base font-semibold tracking-wide uppercase">Stack</p>
				{meta.title && 
				<h2 class="text-zinc-100 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					{meta.title}
				</h2>
				}
				{meta.description && 
				<p class="max-w-3xl mx-auto text-center text-xl">
					{meta.description}
				</p>
				}
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start my-8">
				{
					items.map(({ title, description, icon }) => (
						<div class="relative flex flex-col p-6 bg-zinc-500/20 backdrop-blur-xs rounded-lg shadow-lg border border-zinc-700">
							<div class="flex items-center mb-4">
								<IconLocal name={icon} class="w-12 h-12" />

								<div class="ml-4 text-xl font-bold">{title}</div>
							</div>
							<p class="text-md">{description}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
