---
// src/components/widgets/HeroPortable.astro

const { meta = {} } = Astro.props;
---

<section class="relative">
	<div class="max-w-6xl mx-auto px-4 sm:px-6">
		<div class="py-12 md:py-20">
			<div class="max-w-3xl mx-auto text-center p-6">
				{meta.title && 
				<h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					{meta.title}
				</h2>
				}
				{meta.description && 
				<p class="text-xl text-zinc-600 dark:text-zinc-400">
					{meta.description}
				</p>
				}

				<div class="mt-6">
					<a
						class="btn text-xl text-sky-500 hover:text-lime-500 mb-4 sm:mb-0"
						href="#homelab"
					>
						The Nomad Toolkit
					</a>
				</div>
			</div>
		</div>
<div class="absolute -z-10 inset-0 h-full w-full 
bg-[radial-gradient(circle,#73737350_1px,transparent_1px)] 
bg-[size:10px_10px] 
[mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_80%,transparent_100%)]" />
</section>
