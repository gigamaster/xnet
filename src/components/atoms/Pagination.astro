---
import IconLocal from '~/components/atoms/IconLocal.astro';
import { getPermalink } from '~/utils/permalinks';

const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;

// Function to safely inject the base path if it's missing
const formatPagingUrl = (url) => {
  if (!url) return null;
  // If the URL is already absolute and contains the base, leave it
  if (url.startsWith(import.meta.env.BASE_URL)) return url;
  // Otherwise, prefix it (ensuring no double slashes)
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const path = url.startsWith('/') ? url : `/${url}`;
  return `${base}${path}`;
};

const formattedPrev = formatPagingUrl(prevUrl);
const formattedNext = formatPagingUrl(nextUrl);
---

{
	(formattedPrev || formattedNext) && (
		<div class="container flex">
			<div class="flex flex-row mx-auto container justify-between">
				<a
					href={formattedPrev}
					class={`btn px-2 ... ${!formattedPrev ? 'invisible' : ''}`}
				>
					<div class="flex flex-row align-middle">
						<IconLocal name="fluent--arrow-left-24-regular" class="w-6 h-6" />
						<p class="ml-2">{prevText}</p>
					</div>
				</a>
				<a
					href={formattedNext}
					class={`btn px-2 ... ${!formattedNext ? 'invisible' : ''}`}
				>
					<div class="flex flex-row align-middle">
						<span class="mr-2">{nextText}</span>
						<IconLocal name="fluent--arrow-right-24-regular" class="w-6 h-6" />
					</div>
				</a>
			</div>
		</div>
	)
}