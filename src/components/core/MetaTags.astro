---
// import { GoogleAnalytics } from "@astrolib/analytics"
import defaultImageSrc from '~/assets/images/default.jpg';
import { getRelativeUrlByFilePath } from '~/utils/directories';

import { SITE } from '~/config.mjs';
import Fonts from '../atoms/Fonts.astro';
import ExtraMetaTags from '../atoms/ExtraMetaTags.astro';

const defaultImage = defaultImageSrc;

const {
	title = SITE.name,
	description = '',
	image: _image = defaultImage,

	canonical,
    
	/** * @property {boolean} noindex - Controls search engine visibility.
	 * false (Default): Allow search engines to index this page.
	 * true: Tell search engines NOT to show this page in search results.
	 */
	noindex = false,

	/** * @property {boolean} nofollow - Controls link crawling.
	 * false (Default): Allow bots to follow links on this page.
	 * true: Tell bots NOT to follow or vouch for links on this page.
	 */
	nofollow = false,

	ogTitle = title,
	ogType = 'website',
} = Astro.props;

const image =
	typeof _image === 'string'
		? new URL(_image, Astro.site)
		: _image && typeof _image['src'] !== 'undefined'
		? new URL(getRelativeUrlByFilePath(_image.src), Astro.site)
		: null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta
  name="theme-color"
  content="#d8d3d4"
  media="(prefers-color-scheme: light)" />
<meta
  name="theme-color"
  content="#1b1718"
  media="(prefers-color-scheme: dark)" />
  <base href={import.meta.env.BASE_URL} />

{canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}

{noindex && <meta name="robots" content="noindex" />}
{nofollow && <meta name="robots" content="nofollow" />}

<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.name}
  href={`${import.meta.env.BASE_URL}/rss.xml`}
/>

<!-- Open Graph -->
<meta property="og:url" content={canonical} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
{image && (
	<meta property="og:image" content={image.toString()} />
)}

<!-- Twitter -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

<Fonts />

<!-- Google Site Verification -->
{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}

<!-- Google Analytics -->
<!-- {SITE.googleAnalyticsId && <GoogleAnalytics id={String(SITE.googleAnalyticsId)} partytown={true} />} -->

<ExtraMetaTags />
