---
import { Image } from 'astro:assets';

const {
	src,
	alt,
	sizes,
	widths,
	aspectRatio = 1,
	formats = ['avif', 'webp'],
	loading = 'lazy',
	decoding = 'async',
	class: className = '',
	...attrs
} = Astro.props;

---

{
	src && (
		<Image
			src={src}
			alt={alt}
			sizes={sizes}
			loading={loading}
			decoding={decoding}
			class={className}
			{...attrs}
		/>
	)
}
